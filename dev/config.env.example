# Kopieren nach dev/config.env und anpassen (dev/config.env wird nicht committet).
# Alles ist optional – ohne Angaben sucht das Skript den ILIAS-Container selbst.

# Name des ILIAS-Containers (siehe: docker ps)
#CONTAINER=ilias

# ILIAS-Verzeichnis im Container (dort liegt ilias.ini.php)
#ILIAS_DIR=/var/www/html

# Benutzer des Webservers im Container
#WEB_USER=www-data

# auto = erkennen, mount = Ordner ist per Volume gemountet, copy = in den Container kopieren
#SYNC_MODE=auto

# Nach dem Reload ILIAS im Browser öffnen
#ILIAS_URL=http://localhost:8080
#OPEN_BROWSER=1
